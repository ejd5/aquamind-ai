# AQWELIA — Variables d'environnement
# Copiez ce fichier en .env et adaptez si besoin

# Base de données
# Dev (SQLite): chemin portable relatif (le schema Prisma actuel utilise SQLite)
DATABASE_URL=file:./db/custom.db
# Le runtime refuse une URL incompatible avec ce fournisseur.
DATABASE_PROVIDER=sqlite
# Staging/production PostgreSQL utilise le client généré séparément :
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/aqwelia?schema=public

# Authentification (NextAuth.js)
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.2.0

# Trust X-Forwarded-Host/Proto headers (proxy/preview).
# Supporté depuis next-auth v4.24 (voir node_modules/next-auth/utils/detect-origin.js).
# Requis pour le sandbox/preview (Caddy gateway). En prod, laisser vide si pas de proxy.
AUTH_TRUST_HOST=true

# OAuth Social — Google (https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Client ID → Authorized redirect URI:
#   https://YOUR_DOMAIN/api/auth/callback/google
# (In dev: http://localhost:3000/api/auth/callback/google)
# Leave blank to disable Google login (Credentials-only fallback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth Social — Apple Sign-In (https://developer.apple.com/account/resources/identifiers/list)
# Required by the App Store whenever any other social login is offered.
# 1. Create a Sign In with Apple Service ID (APPLE_CLIENT_ID).
# 2. Register a Key (Key ID = APPLE_KEY_ID) and download the .p8 file. The
#    APPLE_PRIVATE_KEY value should be the full PEM content of that file
#    (header, base64 body, footer). NextAuth accepts the raw multi-line PEM;
#    you can also JSON-encode it as a single line with escaped newlines if
#    your env loader requires it.
# 3. Configure the Return URL: https://YOUR_DOMAIN/api/auth/callback/apple
# Leave all 4 blank to disable Apple login.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# PostHog Analytics (https://us.posthog.com or self-hosted)
# Create a project → Project Settings → API keys. The public key (NEXT_PUBLIC_*)
# is exposed to the browser; the secret server key (POSTHOG_KEY) is used by
# the Node route handlers (trackEventServer).
# Leave blank to disable analytics in dev (no-op, no network calls).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
POSTHOG_KEY=
POSTHOG_HOST=https://us.posthog.com

# Admin emails (CSV) — required for every admin page and admin-only API.
# When unset, admin access is denied by default, including in development.
# ADMIN_EMAILS=founder@aqwelia.app,ops@aqwelia.app

# API backend (pour client mobile Capacitor)
# En dev: relatif. En prod mobile: URL HTTPS du backend déployé
NEXT_PUBLIC_API_BASE_URL=

# Google Maps — AQWELIA Pro Dispatch Live
# Clé navigateur : restreindre aux domaines AQWELIA et à Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Clé serveur : ne jamais exposer au navigateur ; restreindre à Geocoding API
# et Routes API, idéalement aux IP/sorties du backend lorsque l'hébergeur le permet.
GOOGLE_MAPS_SERVER_API_KEY=

# Stripe (web subscriptions)
# Dashboard: https://dashboard.stripe.com/products → create recurring prices
# Price IDs réellement utilisés dans src/lib/stripe.ts:
#   AQWELIA Pool monthly, AQWELIA Complete monthly, AQWELIA Spa monthly
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_PRICE_OASIS_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_OASIS_QUARTERLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_OASIS_SEASONAL=price_xxxxxxxxxxxxx
STRIPE_PRICE_OASIS_YEARLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_WELLNESS_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_WELLNESS_QUARTERLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_WELLNESS_SEASONAL=price_xxxxxxxxxxxxx
STRIPE_PRICE_WELLNESS_YEARLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_SPA365_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_SPA365_QUARTERLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_SPA365_SEASONAL=price_xxxxxxxxxxxxx
STRIPE_PRICE_SPA365_YEARLY=price_xxxxxxxxxxxxx

# RevenueCat (mobile IAP — iOS + Android)
# Dashboard: https://app.revenuecat.com → AQWELIA project → API Keys
# - Public app keys (NEXT_PUBLIC_*) are embedded in the native app and used
#   by `src/lib/billing/revenuecat.ts` to configure the RC SDK at runtime.
# - REVENUECAT_API_KEY is the secret server-side key (used for REST API calls
#   from the backend — grant/refund, user lookup, etc.).
# - REVENUECAT_WEBHOOK_SECRET is the bearer token RC sends in the
#   `Authorization` header of every webhook call. Configured in the RC
#   dashboard under Project Settings → Integrations → Webhook.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxx
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxx
REVENUECAT_API_KEY=sk_xxxxxxxxxxxxx
REVENUECAT_WEBHOOK_SECRET=rc_wh_xxxxxxxxxxxxx

# Z.ai image-edit adapter (ARQWELIA Lot 2 Phase 0A) — BLOCKED for Phase 0A.
# Official Z.AI docs only document POST /api/paas/v4/images/generations
# (text-to-image) with {model, prompt, quality, size, user_id} and a response
# data[0].url (NOT base64). No photo-input image-edit contract is verified —
# the SDK method was detected but no current official API/model contract proves
# photo-to-photo editing. zai-glm is DOCUMENTARY ONLY (not executable). It may
# be re-enabled later only when official docs specify endpoint, exact model,
# input image, output format, price and data policy.
# Z_AI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/v1

# ARQWELIA Lot 2 benchmark — Phase 0A execution intent (THIRD gate). A real
# provider call requires ALL THREE: ARQWELIA_BENCHMARK_AUTHORIZED=true,
# ARQWELIA_BENCHMARK_MAX_BUDGET_EUR>0 and ARQWELIA_BENCHMARK_PHASE0A_EXECUTE=true.
# ARQWELIA_BENCHMARK_PHASE0A_EXECUTE=true

# ARQWELIA Lot 2 Phase 0A — OpenAI gpt-image-2 (PRIMARY model).
# OPENAI_API_KEY is used by the server/CLI only (never logged, never stored).
# OPENAI_BASE_URL is allowlisted: https://api.openai.com/v1 (default) and
# https://eu.api.openai.com/v1. The EU endpoint requires an organization with
# compatible data controls; no real home photo until EU eligibility is confirmed.
# Non-HTTPS / localhost / private IP / query / fragment / userinfo / other host
# are REJECTED. Endpoint = ${OPENAI_BASE_URL without trailing slash}/images/edits.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_PHASE0A_DEFAULT_MODEL=gpt-image-2
# OPENAI_PHASE0A_DEFAULT_SIZE=1536x1024
# OPENAI_PHASE0A_DEFAULT_QUALITY=medium
# OPENAI_PHASE0A_DEFAULT_OUTPUT_FORMAT=png
# Phase 0A retention (no execution in this build): photos=2, concepts=A and B,
# maximumCalls=4, maximumBudgetEur=2 (see docs/release/ARQWELIA_LOT2_BENCHMARK.md).
# Phase 0A dataset gate: ONLY --dataset-kind synthetic is accepted (authorized/
# user/home/real REJECTED). When executeAuthorized the CLI requires
# --dataset-id <controlled>, --dataset-kind synthetic AND --image <photo>.
# ARQWELIA_BENCHMARK_AUTHORIZED concerns SPEND authorization, never photo
# authorization — the manifest records authorizationBasis='synthetic'.
# pricingCheckedAt=2026-08-03 (official gpt-image-2 prices must be re-checked on
# openai.com/api/pricing immediately before any smoke).

# Météo (optionnel - proxy si wttr.in bloqué)
WTTR_IN_BASE_URL=https://wttr.in

# NVIDIA NIM (IA — vision + chat)
# Get a free API key at https://build.nvidia.com (1000 free credits)
# Chat: GLM-5.2 (flagship LLM by Z.ai on NVIDIA NIM)
#   https://build.nvidia.com/z-ai/glm-5.2
# Vision: Llama 3.2 90B Vision (multimodal — required for photo diagnostic)
#   https://build.nvidia.com/explore/vision
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl
NVIDIA_CHAT_MODEL=z-ai/glm-5.2

# SMTP (transactional emails — welcome, lead notifications, trial ending)
# If unset, every email send is a no-op (logs to stdout). Safe for dev/CI.
# Recommended providers: Brevo (smtp-brevo.com:587), Mailgun, Amazon SES.
# Format of EMAIL_FROM: "Display Name <email@domain>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AQWELIA <contact@aqwelia.app>
# Optional: override the team notification address (default: contact@aqwelia.app)
# Used for Pro early-access + Care launch leads.
EMAIL_TO_TEAM=contact@aqwelia.app

# Admin emails (comma-separated, optional)
# Restricts GET /api/pro/early-access and GET /api/care/notify to these emails.
# If unset, any authenticated user can list (loose admin gate).
ADMIN_EMAILS=

# Error monitoring. The current application runs in structured log-only mode
# until the Sentry SDK is installed during deployment preparation.
SENTRY_DSN=

# Temporary App Store / Play Store review account. Disabled by default.
# Enable only during an active review window and use a unique password of at
# least 16 characters. Disable and rotate the credentials after the review.
DEMO_ACCOUNT_ENABLED=false
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=

# Feature flags — disabled until the related service is ready
NEXT_PUBLIC_PRO_GPS_ENABLED=false

# ARQWELIA — Lot 1 flags
# NEXT_PUBLIC_ARQWELIA_LOT1_ENABLED=true makes ARQWELIA visible in the main
# nav / sitemap and routes the primary CTA into the wizard. Default: false
# (routes still resolve for QA but are noindex and hidden from nav).
# NEXT_PUBLIC_ARQWELIA_DEMO_MODE=true shows the "Démo — analyse simulée" badge
# and enables the ?demo=1 path. Default: true outside production.
NEXT_PUBLIC_ARQWELIA_LOT1_ENABLED=false
NEXT_PUBLIC_ARQWELIA_DEMO_MODE=true

# ARQWELIA — Lot 2 A2 AR POC (@google/model-viewer, webxr / scene-viewer /
# quick-look). The POC is DISABLED by default.
#   ARQWELIA_AR_POC_ENABLED (SERVER flag) — ACTIVE at runtime: the
#   /arqwelia/lab/ar-poc Server Component reads it on every request. When
#   false (default) the page renders a disabled state with zero viewer. This
#   is the authority flag; no rebuild needed to flip it.
#   NEXT_PUBLIC_ARQWELIA_AR_POC_ENABLED=true (build-time client flag) — when
#   true, /arqwelia/lab/ar-poc renders the <model-viewer> viewer. When false
#   (default), the AR component renders ZERO DOM. Build-time: changing it
#   requires a rebuild.
ARQWELIA_AR_POC_ENABLED=false
NEXT_PUBLIC_ARQWELIA_AR_POC_ENABLED=false

# Cloudflare Turnstile — public registration protection
# Also enforced on the ARQWELIA contact + partner-waitlist forms. When the
# secret is missing, ARQWELIA fails CLOSED in production (no silent bypass).
# TURNSTILE_REQUIRED=true makes registration fail closed when the keys are absent.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false

# Billing retry cron — same secret in Vercel Production and GitHub Actions
BILLING_RETRY_CRON_SECRET=


# P0-L2 — privacy and legal launch controls
# Client analytics is loaded only after cookie consent. Server analytics is
# disabled unless this flag is explicitly enabled; identified events still
# require consentAnalytics=true for the user.
POSTHOG_SERVER_ENABLED=false
CONSENT_PROOF_SALT=

# Mandatory French legal-notice fields. Do not commercialise while required
# values are blank; /legal/mentions-legales displays the missing fields.
NEXT_PUBLIC_LEGAL_PUBLISHER_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_CAPITAL=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_SIREN=
NEXT_PUBLIC_LEGAL_REGISTER=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_EMAIL=legal@aqwelia.app
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_LEGAL_PUBLICATION_DIRECTOR=
NEXT_PUBLIC_LEGAL_HOST_NAME=
NEXT_PUBLIC_LEGAL_HOST_ADDRESS=
NEXT_PUBLIC_LEGAL_HOST_CONTACT=
NEXT_PUBLIC_LEGAL_MEDIATOR_NAME=
NEXT_PUBLIC_LEGAL_MEDIATOR_URL=
